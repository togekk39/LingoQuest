{
  "expo": {
    "name": "LingoQuest",
    "slug": "lingoquest",
    "version": "2.1.0",
    "scheme": "lingoquest",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.lingoquest.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": ["RECORD_AUDIO"],
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#167D72"
      }
    },
    "ios": {
      "bundleIdentifier": "com.lingoquest.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Practica tu pronunciación de forma opcional. El audio se elimina al salir."
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "LingoQuest · Aprende inglés, descubre el mundo",
      "shortName": "LingoQuest",
      "backgroundColor": "#F5EBDD",
      "themeColor": "#F5EBDD"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Permite el micrófono para practicar tu pronunciación. Siempre puedes omitirlo."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permite el micrófono para practicar tu inglés. Siempre puedes omitirlo.",
          "speechRecognitionPermission": "Permite que el servicio de voz del sistema reconozca tu inglés. Puede necesitar conexión.",
          "androidSpeechServicePackages": ["app.marmalade.stt"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png"
  }
}
