{
  "expo": {
    "name": "LingoQuest",
    "slug": "lingoquest",
    "version": "1.3.0",
    "scheme": "lingoquest",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.lingoquest.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": ["RECORD_AUDIO"],
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#167D72"
      }
    },
    "ios": {
      "bundleIdentifier": "com.lingoquest.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Practica tu pronunciación de forma opcional. El audio se elimina al salir."
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "LingoQuest · Tu inglés, a tu ritmo",
      "shortName": "LingoQuest",
      "backgroundColor": "#F7FAF7",
      "themeColor": "#167D72"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Permite el micrófono para practicar tu pronunciación. Siempre puedes omitirlo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png"
  }
}
