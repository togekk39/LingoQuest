{
  "name": "@lingoquest/mobile",
  "version": "1.2.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "node ../../scripts/expo.mjs start --offline --host lan",
    "web": "node ../../scripts/expo.mjs start --web --offline --port 8081",
    "android": "node ../../scripts/expo.mjs start --android --offline",
    "typecheck": "tsc --noEmit",
    "build:web": "node ../../scripts/expo.mjs export --platform web",
    "build:android": "node ../../scripts/expo.mjs export --platform android --output-dir dist-android"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.3",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@lingoquest/contracts": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.38",
    "expo-asset": "12.0.14",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.11",
    "expo-modules-core": "~3.0.30",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^1.70.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "@lingoquest/course-pack": "*",
    "@lingoquest/offline-engine": "*",
    "expo-speech": "~14.0.8"
  }
}
